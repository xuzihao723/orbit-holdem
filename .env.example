# Local development defaults; no credentials belong in this file.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=.data/orbit.sqlite
# Google sign-in is enabled when both values are set. Register the exact callback URI.
# GOOGLE_CLIENT_ID=<web OAuth client ID>
# GOOGLE_CLIENT_SECRET=<web OAuth client secret>
# Callback on this local origin: http://127.0.0.1:5173/api/auth/google/callback
# Legacy email password mode is opt-in. Use local mode only on loopback.
# AUTH_EMAIL_MODE=local
# For HTTPS deployment choose resend and provide these through private runtime configuration.
# AUTH_EMAIL_MODE=resend
# AUTH_EMAIL_FROM=Orbit <verify@your-domain.example>
# AUTH_CODE_KEY=<64 random hexadecimal characters>
# AUTH_PROXY_KEY=<separate random 64-character hexadecimal ingress key>
# RESEND_API_KEY=<sending-only key>
# Production additionally requires NODE_ENV=production, HTTPS WEB_ORIGIN,
# HOST=0.0.0.0 and WEB_DIST pointing to the built web directory.
