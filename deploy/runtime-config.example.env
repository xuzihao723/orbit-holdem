# Supply an actual authorized domain before starting Compose.
ORBIT_DOMAIN=your-domain.example
# Pin verified image digests for the actual deployment.
NODE_IMAGE=node:24.14.1-bookworm-slim
CADDY_IMAGE=caddy:2
# Google sign-in. Put real values in the private runtime env file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_PROXY_KEY=
# Optional legacy email account delivery.
# AUTH_EMAIL_MODE=resend
# AUTH_EMAIL_FROM="Orbit <verify@your-domain.example>"
# AUTH_CODE_KEY=
# RESEND_API_KEY=
